# Real-Time Chat (Pusher)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=your_pusher_cluster
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=your_pusher_cluster

# Storage configuration
# 'local' = save to public/renders/ (default, for local dev)
# 'drive' = upload to Google Drive (for Vercel deployment)
STORAGE_MODE=local

# Google Drive folder IDs (optional - if not set, uploads to Drive root)
GOOGLE_DRIVE_RENDERS_FOLDER_ID=
GOOGLE_DRIVE_PREVIEWS_FOLDER_ID=

# Google Drive - Service Account (for Vercel deployment, no browser auth needed)
# Paste the entire service account JSON as a single line (minified).
# Generate at: Google Cloud Console → IAM → Service Accounts → Keys → Add Key → JSON
# Then: cat service-account.json | jq -c . (to minify to one line)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ComfyUI URL (for rogue routes that might still need it as fallback)
# Set this to your Cloudflare Tunnel URL when deploying to Vercel
COMFYUI_URL=http://127.0.0.1:8188
COLAB_COMFY_URL=
COLAB_COMFY_WS_URL=

# Renders directory override (optional, for comfyBridge.js on the GPU machine)
# Defaults to <project_root>/public/renders
RENDERS_DIR=