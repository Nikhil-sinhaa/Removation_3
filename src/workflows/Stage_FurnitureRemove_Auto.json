    "info": {
      "name": "Furniture Remover — Auto Mode",
      "description": "Fully automatic furniture removal. GroundingDINO detects furniture bounding boxes from a text prompt, SAM segments precise masks, GrowMask feathers the edges, and LaMa inpaints the background. No user masking required.",
      "author": "Removation Pipeline",
      "version": "1.0",
      "target_gpu": "RTX 4060 8GB",
      "nodes_used": "comfyui_segment_anything (SAMModelLoader, GroundingDinoModelLoader, GroundingDinoSAMSegment), comfyui-lama-remover (LamaRemover), ComfyUI core (LoadImage, GrowMask, SaveImage)",
      "required_models": {
        "sam": "models/sams/sam_vit_h_4b8939.pth",
        "grounding_dino": "models/grounding-dino/groundingdino_swint_ogc.pth",
        "lama": "models/lama/big-lama.pt"
      },
      "tuning_notes": {
        "prompt_v1": "sofa, chair, table, bed, cabinet, lamp — tight starter list. GroundingDINO is greedy; too many concepts cause false positives.",
        "prompt_expand_if_missed": "Add: wardrobe (if dressers/closets visible), plant (if heavy greenery), rug (careful — large fill area, test separately).",
        "prompt_never_add_v1": "decoration (too vague, marks walls/shadows), painting (small patches, LaMa leaves obvious holes), photo frame (same), fan (ceiling fan needs ceiling reconstruction), curtain (translucent, spans wall+floor, LaMa fails).",
        "threshold": "0.3 starting point. Miss furniture → lower to 0.25. Eats into walls/floors → raise to 0.4.",
        "grow_mask_expand": "10px default. Halos visible → raise to 15. Mask bleeds into walls → lower to 5-7.",
        "invert_mask_check": "First run: if furniture stays and surroundings are erased, the mask polarity is wrong — set invert_mask=true on LamaRemover and re-run. One 30-second check, then lock it.",
        "lama_limits": "LaMa works well on uniform walls and textured floors. It struggles when removed furniture would reveal complex geometry (window behind sofa, corner detail). No parameter fixes this — it is the model limit for v1.",
        "gaussblur_radius": "1 (minimal blur at mask edge). Raise to 3 if fringe artifacts visible at removal boundary."
      },
      "node_ids": {
        "1": "LoadImage — INJECT: widgets_values[0] = ComfyUI input filename",
        "2": "SAMModelLoader — dropdown: sam_vit_h (2.56GB)",
        "3": "GroundingDinoModelLoader — dropdown: GroundingDINO_SwinT_OGC (694MB)",
        "4": "GroundingDinoSAMSegment — INJECT: widgets_values[0] = prompt, widgets_values[1] = threshold",
        "5": "GrowMask — INJECT: widgets_values[0] = expand px",
        "6": "LamaRemover — mask_threshold=250, gaussblur_radius=1, invert_mask=false",
        "9": "SaveImage — filename_prefix=furniture-removed/auto"
      }
    }
