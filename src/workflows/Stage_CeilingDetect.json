      "name": "Stage 1: Ceiling Mask Only (VRAM-Safe)",
      "description": "Generates a single binary mask of the ceiling region using CLIPSeg + SAM2 refinement. Output feeds directly into the olive-ceiling inpainting workflow. No SDXL loaded \u2014 peak VRAM ~600MB.",
      "author": "Removation Pipeline",
      "version": "1.0",
      "target_gpu": "RTX 4060 8GB (--lowvram)",
      "required_custom_nodes": [
        "ComfyUI-Impact-Pack (SAMLoader, CLIPSegDetectorProvider, ImpactSimpleDetectorSEGS, SegsToCombinedMask)",
        "ComfyUI-CLIPSeg (biegert/ComfyUI-CLIPSeg \u2014 required by CLIPSegDetectorProvider)"
      ],
      "required_models": {
        "sam2": "sam2_hiera_small.pt \u2192 ComfyUI/models/sams/",
        "clipseg": "auto-downloaded by CLIPSeg node on first run"
      },
      "outputs": {
        "stage1/ceiling_mask": "Binary mask of ceiling surface \u2014 white = ceiling, black = everything else"
      },
      "tuning_tips": {
        "mask_misses_parts_of_ceiling": "Lower the threshold (4th widget on CLIPSegDetectorProvider) from 0.4 to 0.3 or 0.25",
        "mask_bleeds_into_walls": "Raise threshold to 0.5; or raise the SAM detection_hint threshold (1st widget on SimpleDetectorSEGS) from 0.35 to 0.50",
        "no_ceiling_detected_at_all": "Image may have an unusual ceiling \u2014 try replacing prompt with just 'ceiling' or add specific terms like 'wooden ceiling, beam ceiling, coffered ceiling'",
        "mask_too_tight": "Add mask_dilation by raising widget 2 (currently 0) on ImpactSimpleDetectorSEGS to 5-10 pixels"
      },
      "vram_budget": {
        "sam2_hiera_small": "~150MB",
        "clipseg_model": "~150MB",
        "peak_total": "~600MB",
        "sdxl_loaded": false
      }
