      },
      "outputs": {
        "stage3/white_walls": "Image with walls painted white, exact geometry preserved"
      },
      "sampling": {
        "denoise": 0.85,
        "steps": 40,
        "cfg": 9.5,
        "sampler": "dpmpp_2m",
        "scheduler": "karras",
        "rationale": "VAEEncode encodes the full original image intact so latent geometry is preserved. SetLatentNoiseMask then applies the wall mask as a noise region without blurring surrounding pixels. Denoise 0.85 gives the model enough room to change colour without hallucinating new structural geometry. GrowMask removed entirely to prevent mask bleed."
      },
      "fix_summary": {
        "removed": ["Node 6 (GrowMask) — was causing mask bleed into clean regions", "Node 7 (VAEEncodeForInpaint) — was deliberately blurring latent in mask, destroying corners and window frames"],
