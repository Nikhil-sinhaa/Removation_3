  "extra": {
    "ds": {"scale": 0.45, "offset": [50, 30]},
    "info": {
      "name": "Auto Furniture Removal V2 — Device-Fixed",
      "version": "2.0",
      "fixes_from_v1": [
        "DEVICE MISMATCH FIX: Mask is now routed Mask→Image→Mask before going into MinimaxImageRemover. The CLIPSeg+SAM2+SegsToCombinedMask chain produces a CPU-tensor mask. Converting it through MaskToImage and back via ImageToMask forces a fresh tensor that gets placed on the correct device when ImageSizeAdjuster runs.",
        "MinimaxModelLoader device set explicitly to 'cuda' (was 'auto' which can pick cpu when VRAM is tight)",
        "Empty mask fix: All three CLIPSeg thresholds lowered to 0.12-0.15 (was 0.25-0.30) so detectors don't return zero SEGS on smaller/lower-contrast images",
        "SimpleDetectorSEGS detection threshold lowered 0.20-0.35 → 0.15"
      ],
      "device_mismatch_root_cause": "MinimaxImageRemover expects its mask tensor on the same device as its transformer (cuda). When a mask comes from CPU-side operations (CLIPSeg → SAM2 → SegsToCombinedMask → GrowMask), it stays on CPU. ComfyUI doesn't auto-migrate it because the node signature doesn't declare a device requirement. The Mask→Image→Mask round-trip forces ComfyUI to materialize a fresh tensor, which the ImageSizeAdjuster downstream then aligns correctly.",
      "how_to_use": "1) Load room image  2) Set LEVEL primitive to 1/2/3  3) Queue  4) CHECK furniture_removal/debug_mask_*.png FIRST — confirm furniture is white on black. If mask is correct but result is wrong, the issue is Minimax. If mask is empty, lower thresholds further.",
      "tuning": {
        "empty_mask_warning_in_log": "Lower CLIPSeg threshold from 0.15 to 0.10 or even 0.08 on the active level detector. Lower SimpleDetectorSEGS threshold (widget 1) to 0.10.",
        "still_device_error": "Check that MinimaxModelLoader has device='cuda' not 'auto' or 'cpu'. Restart ComfyUI fully to release stuck CPU tensors.",
        "removes_walls_too": "Raise CLIPSeg threshold on active level back to 0.20-0.25, OR drop one level (level 2→1)"
      }
    }
  },
  "version": 0.4
}