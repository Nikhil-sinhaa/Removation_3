    "info": {
      "name": "Stage 5+6: Refinement, Upscale & Final Sharpen",
      "description": "Combined refinement and upscale pipeline. Stage 5: iterative low-denoise global pass + MaskDetailerPipe for wall/furniture regions. Stage 6: 4x-UltraSharp model upscale → controlled downscale → low-denoise refinement → final sharpen.",
      "author": "Removation Pipeline",
      "version": "1.0",
      "target_gpu": "RTX 4060 8GB (--lowvram --fp8_e4m3fn)",
      "node_class_types_verified": {
        "MaskDetailerPipe": "Impact Pack impact_pack.py:1738 — takes IMAGE+MASK+BASIC_PIPE, refines only masked regions",
        "ToBasicPipe": "Impact Pack pipe.py:129 — assembles BASIC_PIPE from individual inputs",
        "UpscaleModelLoader": "ComfyUI comfy_extras/nodes_upscale_model.py:18 — loads .pth upscale models",
        "ImageUpscaleWithModel": "ComfyUI comfy_extras/nodes_upscale_model.py:49 — pixel-space model upscale",
        "ImageScale": "ComfyUI core nodes.py:1857 — resize to exact dimensions",
        "ImageSharpen": "ComfyUI comfy_extras/nodes_post_processing.py:180 — unsharp mask (radius, sigma, alpha)",
        "CheckpointLoaderSimple": "ComfyUI core",
        "CLIPTextEncode": "ComfyUI core",
        "VAEEncode": "ComfyUI core",
        "VAEDecode": "ComfyUI core",
        "KSampler": "ComfyUI core",
        "LoadImage": "ComfyUI core",
        "SaveImage": "ComfyUI core"
      },
      "stage5_refinement": {
        "pass_1_global": {
          "purpose": "Harmonize entire image — fix seams, blend regions, ensure tonal consistency",
          "denoise": 0.25,
          "steps": 15,
          "cfg": 4.5,
          "note": "Very low denoise to avoid altering structure. Just smooths transitions."
        },
        "pass_2_wall_detailer": {
          "purpose": "Enhance wall texture detail — fix blurry patches on walls",
          "type": "MaskDetailerPipe",
          "mask": "wall_mask from Stage 1",
          "denoise": 0.35,
          "guide_size": 512,
          "max_size": 1024,
          "crop_factor": 3.0,
          "note": "Crops wall regions, refines at 512px guide, composites back"
        },
        "pass_3_furniture_detailer": {
          "purpose": "Sharpen furniture detail — enhance product texture and edges",
          "type": "MaskDetailerPipe",
          "mask": "object_mask from Stage 1",
          "denoise": 0.40,
          "guide_size": 512,
          "max_size": 1024,
          "crop_factor": 3.0,
          "note": "Same process but higher denoise for more detail recovery on furniture"
        }
      },
      "stage6_upscale": {
        "model_upscale": {
          "model": "RealESRGAN_x4plus.pth",
          "factor": "4×",
          "note": "Pixel-space upscale using pre-trained super-resolution model"
        },
        "controlled_downscale": {
          "target": "2048×2048",
          "method": "lanczos",
          "note": "Downscale 4× to 2× to control detail level and VRAM usage"
        },
        "refinement_pass": {
          "denoise": 0.20,
          "steps": 12,
          "cfg": 4.0,
          "note": "Very gentle pass to add SD-level detail to upscaled image"
        },
        "final_sharpen": {
          "sharpen_radius": 2,
          "sigma": 0.65,
          "alpha": 0.55,
          "note": "Subtle unsharp mask for crisp edges without haloing"
        }
      },
      "inputs": {
        "stage4_output": "Furniture-placed image from Stage 4",
        "wall_mask": "Wall mask from Stage 1",
        "object_mask": "Furniture/object mask from Stage 1"
      },
      "outputs": {
        "stage5/refined": "Base-resolution refined image (intermediate)",
        "stage6_final/ultra_hd_result": "Final 2048×2048 ultra-HD sharpened output"
      },
      "required_models": {
