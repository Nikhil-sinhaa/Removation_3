      "ipadapter_chain": {
        "pass_1_style": {
          "purpose": "Transfer overall aesthetic from moodboard/reference image",
          "weight": 0.40,
          "weight_type": "linear",
          "embeds_scaling": "K+V w/ C penalty",
          "start_at": 0.0,
          "end_at": 1.0,
          "attn_mask": "none — applies globally",
          "note": "Low weight prevents style from overwhelming room structure"
        },
        "pass_2_furniture": {
          "purpose": "Inject specific furniture product into object mask area",
          "weight": 0.80,
          "weight_type": "linear",
          "embeds_scaling": "V only",
          "start_at": 0.0,
          "end_at": 0.85,
          "attn_mask": "object_mask from Stage 1 — restricts furniture influence to detected object areas",
          "prep": "pad mode + sharpening 0.1 for product images with transparent BG"
        }
      },
      "inputs": {
        "stage3_output": "Regional inpainted image from Stage 3",
        "style_reference": "Moodboard or style reference image (e.g. Pinterest board screenshot)",
        "furniture_product": "Background-removed product image (from Amazon/Flipkart via rembg)",
        "object_mask": "Furniture placement mask from Stage 1",
        "depth_map": "Depth map from Stage 1 (for spatial ControlNet)"
      },
      "outputs": {
        "stage4/furniture_placed": "Image with style applied and furniture placed via IPAdapter"
      },
