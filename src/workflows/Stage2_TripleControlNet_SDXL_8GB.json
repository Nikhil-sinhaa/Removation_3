    "info": {
      "name": "Stage 2: Geometry Locking — Triple ControlNet",
      "description": "Locks room geometry using 3 chained ControlNet LoRAs (Depth → Canny → Lineart) on SDXL. Ensures structural integrity of walls, windows, doors while allowing surface/style changes. img2img denoise 0.50.",
      "author": "Removation Pipeline",
      "version": "1.0",
      "target_gpu": "RTX 4060 8GB (--lowvram --fp8_e4m3fn)",
      "node_class_types_verified": {
        "Canny": "ComfyUI core — built-in edge detector",
        "LineArtPreprocessor": "comfyui_controlnet_aux/node_wrappers/lineart.py:26",
        "ControlNetLoader": "ComfyUI core — loads .safetensors controlnet models",
        "ControlNetApplyAdvanced": "ComfyUI core — applies controlnet with strength + start/end percent",
        "CheckpointLoaderSimple": "ComfyUI core",
        "CLIPTextEncode": "ComfyUI core",
        "VAEEncode": "ComfyUI core",
        "KSampler": "ComfyUI core",
        "VAEDecode": "ComfyUI core",
        "SaveImage": "ComfyUI core"
      },
      "controlnet_chain": {
        "step_1_depth": {
          "model": "control-lora-depth-rank256.safetensors (~400MB)",
          "strength": 0.90,
          "start": 0.0,
          "end": 1.0,
          "purpose": "Locks 3D geometry — walls stay at correct angles"
        },
        "step_2_canny": {
          "model": "control-lora-canny-rank256.safetensors (~400MB)",
          "strength": 0.65,
          "start": 0.0,
          "end": 0.85,
          "purpose": "Preserves hard edges — window frames, door frames, corners"
        },
        "step_3_lineart": {
          "model": "control-lora-sketch-rank256.safetensors (~400MB)",
          "strength": 0.45,
          "start": 0.0,
          "end": 0.70,
          "purpose": "Maintains fine structural details — trim, molding, fixtures"
        }
      },
      "required_models": {
        "sdxl_checkpoint": "sd_xl_base_1.0.safetensors → models/checkpoints/",
        "depth_controlnet_lora": "control-lora-depth-rank256.safetensors → models/controlnet/",
        "canny_controlnet_lora": "control-lora-canny-rank256.safetensors → models/controlnet/",
        "lineart_controlnet_lora": "control-lora-sketch-rank256.safetensors → models/controlnet/"
      },
      "required_custom_nodes": [
        "comfyui_controlnet_aux (LineArtPreprocessor)"
      ],
      "inputs": {
        "original_image": "The original room photo",
        "depth_map": "Output from Stage 1 (stage1/depth_map_00001_.png)"
      },
      "outputs": {
        "stage2/redesigned": "Geometry-locked redesigned image with preserved structure"
      },
      "vram_budget": {
        "sdxl_base_fp8": "~4.5GB",
        "controlnet_lora_x3": "~600MB (3 × 200MB)",
        "vae_encode_decode": "~200MB",
        "peak_total": "~5.3GB — safe for 8GB GPU",
        "note": "ControlNet LoRAs are much smaller than full ControlNets (2.5GB each). Using rank128 LoRAs keeps total VRAM under 6GB."
      },
      "sampling": {
        "denoise": 0.50,
        "steps": 25,
        "cfg": 5.0,
        "sampler": "dpmpp_2m",
        "scheduler": "karras",
        "rationale": "Denoise 0.50 preserves ~50% of original structure while allowing meaningful style changes. CFG 5.0 is moderate to avoid oversaturation."
      }
    }
  },
