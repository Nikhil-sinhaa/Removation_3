    "info": {
      "name": "Furniture Remover — Manual Mode",
      "description": "User-driven furniture removal. The user provides a hand-painted mask (black image, white areas = zones to remove). ImageToMask extracts the red channel, GrowMask adds a small feather, and LaMa inpaints the background. No AI segmentation required — full user control over what gets removed.",
      "author": "Removation Pipeline",
      "version": "1.0",
      "target_gpu": "RTX 4060 8GB",
      "nodes_used": "comfyui-lama-remover (LamaRemover), ComfyUI core (LoadImage, ImageToMask, GrowMask, SaveImage)",
      "required_models": {
        "lama": "models/lama/big-lama.pt"
      },
      "mask_format": {
        "description": "User paints mask in any image editor (GIMP, Photopea, MS Paint)",
        "background": "Black (#000000) = keep",
        "foreground": "White (#FFFFFF) = remove",
        "format": "PNG, same pixel dimensions as the room photo",
        "channel": "ImageToMask reads the RED channel — a pure white image works fine"
      },
      "tuning_notes": {
        "grow_mask_expand": "5px default (user drew precisely). Raise to 10 if mask boundary artifacts visible.",
        "gaussblur_radius": "1 (minimal blur). Raise to 2-3 if jagged mask edges produce fringe in output.",
        "lama_mask_threshold": "250 (default). LamaRemover: areas BELOW threshold are removed. White pixels (255) exceed 250 so are preserved — but invert_mask=false means the remover treats black areas as 'remove'. Test with a white-on-black mask first."
      },
      "lama_mask_inversion_note": "LamaRemover internally inverts: it removes where the mask is DARK. If painting white-on-black and nothing gets removed, toggle invert_mask to true.",
      "node_ids": {
        "1": "LoadImage (room photo) — INJECT: widgets_values[0] = ComfyUI input filename",
        "2": "LoadImage (mask PNG)  — INJECT: widgets_values[0] = ComfyUI input filename",
        "3": "ImageToMask — channel=red (fixed)",
        "4": "GrowMask — INJECT: widgets_values[0] = expand px",
        "5": "LamaRemover — mask_threshold=250, gaussblur_radius=1, invert_mask=false",
        "8": "SaveImage — filename_prefix=furniture-removed/manual"
      }
    }
